import { AsyncLocalStorage } from "node:async_hooks";
function langFromEnv(env) {
  const raw = [env.LC_ALL, env.LC_MESSAGES, env.LANG].map((v) => v?.trim() ?? "").find((v) => v !== "") ?? "";
  return /^es(?:$|[_.@-])/i.test(raw) ? "es" : "en";
}
var current = new AsyncLocalStorage();
function withLang(lang3, fn) {
  return current.run(lang3, fn);
}
function lang() {
  return current.getStore() ?? "en";
}
function t(en, es) {
  return lang() === "es" ? es : en;
}
function plural(n, en, es) {
  const [one, many] = lang() === "es" ? es : en;
  return `${n} ${n === 1 ? one : many}`;
}

// src/api.ts
var p = encodeURIComponent;
var ROUTES = {
  /**
   * GET: snapshot completo · PUT: reemplaza el grafo entero (idempotente). Con `If-None-Match: *` solo
   * crea: 409 si ya existe. Con la API key conserva los bloqueantes (abiertos y respondidos) y responde
   * 409 si el grafo nuevo quita una tarea que tiene alguno.
   */
  project: (projectId) => `/api/projects/${p(projectId)}`,
  /**
   * GET `?since=<seq>`: los eventos con `seq > since` (≤500 por página). `resync: true` = el log ya no llega
   * hasta `since`: vuelve a pedir el snapshot.
   */
  events: (projectId) => `/api/projects/${p(projectId)}/events`,
  /** GET: el siguiente nodo arrancable y su línea `/goal`. */
  next: (projectId) => `/api/projects/${p(projectId)}/next`,
  /** POST: crea un nodo. */
  nodes: (projectId) => `/api/projects/${p(projectId)}/nodes`,
  /** PATCH: actualiza un nodo. */
  node: (projectId, nodeId2) => `/api/projects/${p(projectId)}/nodes/${p(nodeId2)}`,
  /** POST: cierra un nodo con motivo `{ as, why?, by?, reportUrl? }` (#90). */
  close: (projectId, nodeId2) => `/api/projects/${p(projectId)}/nodes/${p(nodeId2)}/close`,
  /** POST: crea una arista `{ from, to, kind?, why? }`: «necesita» o, con `kind: 'origin'`, «nació de» (#90). */
  edges: (projectId) => `/api/projects/${p(projectId)}/edges`,
  /** POST: abre un bloqueante sobre el nodo. */
  blockers: (projectId, nodeId2) => `/api/projects/${p(projectId)}/nodes/${p(nodeId2)}/blockers`,
  /**
   * GET long-poll (`timeout` ≤25 s): 200 `BlockerWaitResult` apenas se resuelve, o al vencer con el
   * bloqueante todavía `open` (entonces se vuelve a llamar).
   */
  wait: (projectId, blockerId) => `/api/projects/${p(projectId)}/blockers/${p(blockerId)}/wait`,
  /** PUT: upsert parcial de un equipo de la fábrica (#75); sin cambios no emite nada. */
  team: (projectId, teamId) => `/api/projects/${p(projectId)}/teams/${p(teamId)}`,
  /** POST: mensaje corto del agente al PM. */
  messages: (projectId, nodeId2) => `/api/projects/${p(projectId)}/nodes/${p(nodeId2)}/messages`
};
var ApiRequestError = class extends Error {
  constructor(status2, code2, message, reason) {
    super(message);
    this.status = status2;
    this.code = code2;
    this.reason = reason;
    this.name = "ApiRequestError";
  }
  status;
  code;
  reason;
};
var RETRY_DELAYS_MS = [300, 900];
var jitter = (ms) => Math.round(ms * (0.5 + Math.random()));
var transient = (err) => err.status === 0 || err.status === 503 && (err.code === "unavailable" || err.code === "http_503");
var DagyardClient = class {
  baseUrl;
  key;
  fetchImpl;
  retryDelaysMs;
  sleep;
  constructor(opts) {
    this.baseUrl = opts.baseUrl.replace(/\/+$/, "");
    this.key = opts.key;
    this.fetchImpl = opts.fetch ?? fetch;
    this.retryDelaysMs = opts.retryDelaysMs ?? RETRY_DELAYS_MS;
    this.sleep = opts.sleep ?? ((ms) => new Promise((r) => setTimeout(r, ms)));
  }
  /** `exclusive`: creación exclusiva (`If-None-Match: *`); si el proyecto ya existe, 409 sin tocarlo. */
  putProject(projectId, graph, opts = {}) {
    return this.json("PUT", ROUTES.project(projectId), graph, opts.exclusive ? { "if-none-match": "*" } : {});
  }
  snapshot(projectId) {
    return this.json("GET", ROUTES.project(projectId));
  }
  /** Una página del log de eventos después de `since` (`dagyard watch`, #121). */
  events(projectId, since) {
    return this.json("GET", `${ROUTES.events(projectId)}?since=${since}`);
  }
  next(projectId) {
    return this.json("GET", ROUTES.next(projectId));
  }
  addNode(projectId, node) {
    return this.json("POST", ROUTES.nodes(projectId), node);
  }
  /** `teamId` (#75): el sitio que la toma; el servidor la suma a ese equipo. */
  updateNode(projectId, nodeId2, patch) {
    return this.json("PATCH", ROUTES.node(projectId, nodeId2), patch);
  }
  /** Sin `kind`, «necesita»; `kind: 'origin'` = «nació de», con su `why` (#90). */
  addEdge(projectId, from, to, opts = {}) {
    const body = opts.kind === "origin" ? { from, to, kind: "origin", ...opts.why ? { why: opts.why } : {} } : { from, to };
    return this.json("POST", ROUTES.edges(projectId), body);
  }
  /** Cierra con motivo (#90): lista, reemplazada, descartada o «aprendimos». */
  closeNode(projectId, nodeId2, input) {
    return this.json("POST", ROUTES.close(projectId, nodeId2), input);
  }
  openBlocker(projectId, nodeId2, input) {
    return this.json("POST", ROUTES.blockers(projectId, nodeId2), input);
  }
  /** Una vuelta de long-poll: `null` si venció con el bloqueante todavía abierto. */
  async waitOnce(projectId, blockerId, timeoutSec) {
    const qs = new URLSearchParams({ timeout: String(timeoutSec) });
    const res = await this.request("GET", `${ROUTES.wait(projectId, blockerId)}?${qs}`);
    if (res.status === 204) return null;
    const body = await res.json();
    return body.blocker.status === "resolved" ? body : null;
  }
  putTeam(projectId, teamId, patch) {
    return this.json("PUT", ROUTES.team(projectId, teamId), patch);
  }
  postMessage(projectId, nodeId2, input) {
    return this.json("POST", ROUTES.messages(projectId, nodeId2), input);
  }
  async json(method, path, body, extra2 = {}) {
    const res = await this.request(method, path, body, extra2);
    if (res.status === 204) return void 0;
    return await res.json();
  }
  /**
   * Una invocación de la API. Toda escritura lleva una `Idempotency-Key` nueva, la misma en cada reintento:
   * así reintentar un `503 unavailable` o un corte de red (la escritura pudo quedar) nunca la duplica.
   */
  async request(method, path, body, extra2 = {}) {
    const headers = {
      ...extra2,
      authorization: `Bearer ${this.key}`,
      accept: "application/json"
    };
    if (body !== void 0) headers["content-type"] = "application/json";
    if (method !== "GET" && method !== "HEAD") headers["idempotency-key"] = crypto.randomUUID();
    for (let attempt = 0; ; attempt++) {
      try {
        return await this.attempt(method, path, headers, body);
      } catch (err) {
        if (!(err instanceof ApiRequestError) || !transient(err) || attempt >= this.retryDelaysMs.length) throw err;
        await this.sleep(jitter(this.retryDelaysMs[attempt]));
      }
    }
  }
  async attempt(method, path, headers, body) {
    let res;
    try {
      res = await this.fetchImpl(`${this.baseUrl}${path}`, {
        method,
        headers,
        body: body === void 0 ? void 0 : JSON.stringify(body)
      });
    } catch (err) {
      const cause = err instanceof Error ? err.message : String(err);
      throw new ApiRequestError(0, "network", t(`could not reach ${this.baseUrl}: ${cause}`, `no pude conectar con ${this.baseUrl}: ${cause}`));
    }
    if (!res.ok) {
      let code2 = `http_${res.status}`;
      let message = res.statusText || "error";
      let reason;
      try {
        const err = await res.json();
        if (err.error?.code) code2 = err.error.code;
        if (err.error?.message) message = err.error.message;
        if (err.error?.reason === "exists") reason = err.error.reason;
      } catch {
      }
      throw new ApiRequestError(res.status, code2, message, reason);
    }
    return res;
  }
};

// src/args.ts
var UsageError = class extends Error {
  constructor(message) {
    super(message);
    this.name = "UsageError";
  }
};
var ALIASES = { h: "help", q: "q", p: "project" };
function parseArgs(argv, booleans) {
  const out = { positionals: [], flags: {}, bools: /* @__PURE__ */ new Set(), seq: [] };
  const isBool = (k) => booleans.includes(k) || k === "help";
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--") {
      out.positionals.push(...argv.slice(i + 1));
      break;
    }
    const m = /^--?([A-Za-z][\w-]*)(?:=(.*))?$/.exec(arg);
    if (!m || /^-\d/.test(arg)) {
      out.positionals.push(arg);
      continue;
    }
    const key = ALIASES[m[1]] ?? m[1];
    if (isBool(key)) {
      if (m[2] !== void 0) throw new UsageError(t(`--${key} takes no value`, `--${key} no lleva valor`));
      out.bools.add(key);
      continue;
    }
    let value = m[2];
    if (value === void 0) {
      value = argv[++i];
      if (value === void 0) throw new UsageError(t(`--${key} needs a value`, `a --${key} le falta el valor`));
    }
    (out.flags[key] ??= []).push(value);
    out.seq.push([key, value]);
  }
  return out;
}
function flag(a, key) {
  const v = a.flags[key];
  return v ? v[v.length - 1] : void 0;
}
function assertKnownFlags(a, allowed) {
  for (const k of Object.keys(a.flags)) {
    if (!allowed.includes(k)) throw new UsageError(t(`unknown option: --${k}`, `opci\xF3n desconocida: --${k}`));
  }
}

// src/config.ts
import { readFileSync, statSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
var REPO_CONFIG = ".dagyard.json";
var TRUSTED_ORIGINS = ["https://dagyard.cofoundy-dev.workers.dev", "https://dagyard.run"];
function loadConfig(env = process.env, cwd = process.cwd(), opts = {}) {
  const repo = readRepoConfig(cwd, env.HOME || homedir());
  const envUrl = env.DAGYARD_URL?.trim();
  let repoUrl = null;
  if (repo?.url && !envUrl && !opts.skipRepoUrl) {
    if (isTrustedUrl(repo.url, env)) repoUrl = repo.url;
    else {
      const warn = opts.warn ?? ((m) => process.stderr.write(m));
      const trustFile = join(configDir(env), "trusted-urls");
      warn(
        t(
          `dagyard: ignoring the url in ${repo.path} (\xAB${repo.url}\xBB): it is not https or its origin is not trusted. If it is yours, add it to ${trustFile}.
`,
          `dagyard: ignoro la url de ${repo.path} (\xAB${repo.url}\xBB): no es https o su origen no es de confianza. Si es tuya, agr\xE9gala a ${trustFile}.
`
        )
      );
    }
  }
  return {
    url: envUrl || repoUrl || fromConfigDir(env, "url"),
    key: loadKey(env),
    project: env.DAGYARD_PROJECT?.trim() || repo?.project || fromConfigDir(env, "project")
  };
}
function loadKey(env = process.env) {
  return env.DAGYARD_KEY?.trim() || fromConfigDir(env, "agent-key");
}
function isTrustedUrl(raw, env = process.env) {
  let u;
  try {
    u = new URL(raw);
  } catch {
    return false;
  }
  if (u.protocol !== "https:" || u.username || u.password) return false;
  const trusted = new Set(TRUSTED_ORIGINS);
  const extra2 = [
    env.DAGYARD_URL,
    fromConfigDir(env, "url"),
    ...(fromConfigDir(env, "trusted-urls") ?? "").split(/\r?\n/).filter((l) => !l.trim().startsWith("#"))
  ];
  for (const s of extra2) {
    const o = originOf(s?.trim());
    if (o) trusted.add(o);
  }
  return trusted.has(u.origin);
}
function originOf(s) {
  if (!s) return null;
  try {
    const o = new URL(s).origin;
    return o === "null" ? null : o;
  } catch {
    return null;
  }
}
function findRepoConfig(cwd, home = homedir()) {
  let dir = resolve(cwd);
  const stop = resolve(home);
  for (; ; ) {
    const candidate = join(dir, REPO_CONFIG);
    if (isFile(candidate)) return candidate;
    if (exists(join(dir, ".git")) || dir === stop) return null;
    const up = dirname(dir);
    if (up === dir) return null;
    dir = up;
  }
}
function isFile(p2) {
  try {
    return statSync(p2).isFile();
  } catch {
    return false;
  }
}
function exists(p2) {
  try {
    statSync(p2);
    return true;
  } catch {
    return false;
  }
}
function readRepoConfig(cwd, home) {
  const path = findRepoConfig(cwd, home);
  if (!path) return null;
  let data;
  try {
    data = JSON.parse(readFileSync(path, "utf8"));
  } catch (err) {
    const why = err instanceof Error ? err.message : String(err);
    throw new UsageError(
      t(
        `${path} is not valid JSON (${why}); it must be {"project": "\u2026", "url": "\u2026"}`,
        `${path} no es JSON v\xE1lido (${why}); debe ser {"project": "\u2026", "url": "\u2026"}`
      )
    );
  }
  if (!data || typeof data !== "object" || Array.isArray(data)) {
    throw new UsageError(t(`${path} must be an object {"project": "\u2026", "url": "\u2026"}`, `${path} debe ser un objeto {"project": "\u2026", "url": "\u2026"}`));
  }
  const o = data;
  const field = (k) => {
    const v = o[k];
    if (v === void 0 || v === null) return null;
    if (typeof v !== "string") throw new UsageError(t(`${path}: "${k}" must be text`, `${path}: "${k}" debe ser texto`));
    return v.trim() || null;
  };
  return { path, project: field("project"), url: field("url") };
}
function configDir(env) {
  return env.DAGYARD_CONFIG_DIR || join(homedir(), ".config", "dagyard");
}
function fromConfigDir(env, name) {
  try {
    return readFileSync(join(configDir(env), name), "utf8").trim() || null;
  } catch {
    return null;
  }
}

