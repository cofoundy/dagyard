// src/ledger.ts
function parseLedger(text) {
  const trimmed = text.trim();
  let raw;
  let invalid = 0;
  if (trimmed.startsWith("[")) {
    raw = JSON.parse(trimmed);
  } else {
    raw = [];
    for (const line of trimmed.split("\n")) {
      if (!line.trim()) continue;
      try {
        raw.push(JSON.parse(line));
      } catch {
        invalid++;
      }
    }
  }
  const rows = [];
  for (const r of raw) {
    if (legible(r)) rows.push(r);
    else invalid++;
  }
  return { rows, invalid };
}
function legible(r) {
  if (typeof r !== "object" || r === null || Array.isArray(r)) return false;
  const o = r;
  if (typeof o.site !== "string" || !o.site.trim() || o.site.trim().length > LIMITS.slug) return false;
  if (typeof o.event !== "string" || typeof o.ts !== "string") return false;
  if (o.issues === void 0) return true;
  if (!Array.isArray(o.issues)) return false;
  return o.issues.every((x) => (typeof x === "string" || typeof x === "number" && Number.isFinite(x)) && `gh-${String(x).trim()}`.length <= LIMITS.slug);
}
function teamsFromLedger(rows, repo) {
  const anyRepo = rows.some((r) => typeof r.repo === "string");
  const mine = rows.map((r, i) => ({ r, i, at: normalizeIso(r.ts) })).filter(({ r, at }) => at !== null && (anyRepo ? r.repo === repo : true)).sort((a, b) => a.at < b.at ? -1 : a.at > b.at ? 1 : a.i - b.i);
  const skipped = rows.length - mine.length;
  const byId = /* @__PURE__ */ new Map();
  for (const { r, at } of mine) {
    const id = isSlug(r.site) ? r.site : slugify(r.site);
    let t2 = byId.get(id);
    if (!t2) byId.set(id, t2 = { id, nodeIds: [], requestedAt: null, startedAt: null, closedAt: null, outcome: null });
    const reopen = () => {
      t2.closedAt = null;
      t2.outcome = null;
    };
    if (r.event === "requested") {
      t2.requestedAt ??= at;
      if (t2.closedAt) reopen();
      for (const issue of r.issues ?? []) {
        const n = String(issue).trim().replace(/^#/, "");
        const nid = `gh-${n}`;
        if (/^\d+$/.test(n) && !t2.nodeIds.includes(nid) && t2.nodeIds.length < TEAM_LIMITS.nodeIds) t2.nodeIds.push(nid);
      }
    } else if (r.event === "started") {
      t2.startedAt ??= at;
      if (t2.closedAt) reopen();
    } else if (r.event === "closed") {
      t2.closedAt = at;
      const outcome = typeof r.outcome === "string" ? r.outcome.trim() : "";
      t2.outcome = outcome ? [...outcome].slice(0, TEAM_LIMITS.outcome).join("") : null;
    }
  }
  const teams = [...byId.values()];
  const key = (t2) => t2.startedAt ?? t2.requestedAt ?? "";
  teams.sort((a, b) => key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0);
  return { teams, skipped };
}
function teamPatchFromLedger(l, current2) {
  const patch = {};
  const extra2 = l.nodeIds.filter((id) => !current2?.nodeIds.includes(id));
  if (extra2.length) patch.addNodeIds = extra2;
  for (const k of ["requestedAt", "startedAt", "closedAt", "outcome"]) if (l[k] !== null && l[k] !== current2?.[k]) patch[k] = l[k];
  return current2 && !Object.keys(patch).length ? null : patch;
}

