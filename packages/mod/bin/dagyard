function build(files, opts) {
  const warnings = [];
  const tasks = files.map((f) => parseTask(f.file, f.text));
  if (tasks.length > LIMITS.nodesPerProject) {
    throw new Error(
      t(
        `there are ${tasks.length} tasks; a project holds at most ${LIMITS.nodesPerProject}`,
        `son ${tasks.length} tareas; el m\xE1ximo por proyecto es ${LIMITS.nodesPerProject}`
      )
    );
  }
  const nodeIds = [];
  const used = /* @__PURE__ */ new Set();
  for (const t2 of tasks) {
    const base = slugify(t2.id) || slugify(t2.file.replace(/\.md$/i, "")) || "tarea";
    let id = base;
    for (let n = 2; used.has(id); n++) id = `${base.slice(0, LIMITS.slug - 3)}-${n}`;
    if (id !== base) warnings.push(t(`${t2.file}: the id \xAB${t2.id}\xBB is repeated; it became \xAB${id}\xBB`, `${t2.file}: el id \xAB${t2.id}\xBB se repite; qued\xF3 como \xAB${id}\xBB`));
    used.add(id);
    nodeIds.push(id);
  }
  const byAlias = /* @__PURE__ */ new Map();
  tasks.forEach((t2, i) => {
    for (const a of t2.aliases) if (!byAlias.has(a.toLowerCase())) byAlias.set(a.toLowerCase(), i);
  });
  const deps = tasks.map(() => []);
  tasks.forEach((t2, to) => {
    const unknown = /* @__PURE__ */ new Set();
    for (const ref of t2.depRefs) {
      for (const token of ref.match(/[A-Za-z][A-Za-z0-9]*(?:[-_][A-Za-z0-9]+)*/g) ?? []) {
        const from = byAlias.get(token.toLowerCase());
        if (from === void 0) {
          if (/^T-|\d/.test(token) && /^[A-Z]/.test(token)) unknown.add(token);
          continue;
        }
        if (from !== to && !deps[to].includes(from)) deps[to].push(from);
      }
    }
    if (unknown.size) {
      const refs = [...unknown].join(", ");
      warnings.push(t(`${t2.file}: depends on ${refs}, which are not in the folder`, `${t2.file}: depende de ${refs}, que no est\xE1n en el directorio`));
    }
  });
  for (const [from, to] of breakCycles(deps)) {
    deps[to] = deps[to].filter((d) => d !== from);
    const edge = `${tasks[to].file} \u2192 ${tasks[from].file}`;
    warnings.push(t(`loop: removed the dependency ${edge}`, `ciclo: se quit\xF3 la dependencia ${edge}`));
  }
  const depth = longestPathDepth(deps);
  const statuses = tasks.map(effectiveStatus);
  const dataLang = opts.projectLang ?? DEFAULT_LANG;
  const { stages: stages2, stageOf, source } = inferStages(tasks, depth, dataLang);
  const given = opts.titles ? givenTitles(opts.titles, tasks, nodeIds, warnings) : null;
  const tasksPath = (opts.tasksPath ?? ".cofoundy/tasks").replace(/\/+$/, "");
  const nodes = tasks.map((t2, i) => {
    const title = given?.get(i) ?? legibleTitle(t2.title, t2.summary);
    return {
      id: nodeIds[i],
      stage: stageOf[i],
      title,
      status: statuses[i],
      progress: statuses[i] === "done" ? 1 : 0,
      team: t2.team,
      goal: t2.goal ?? oneLine(importGoal(title, `${tasksPath}/${t2.file}`, dataLang), LIMITS.goal),
      deps: deps[i].map((d) => nodeIds[d])
    };
  });
  let askers = 0;
  tasks.forEach((t2, i) => {
    if (!asksHuman(t2, deps[i], tasks)) return;
    askers++;
    const title = nodes[i].title;
    warnings.push(
      t(
        `\xAB${title}\xBB asks a person for something; it stays Pending. Ask them live with dagyard block`,
        `\xAB${title}\xBB pide algo a una persona; qued\xF3 Pendiente. Preg\xFAntaselo en vivo con dagyard block`
      )
    );
  });
  const projectId = importProjectId(opts);
  const name = oneLine(opts.name ?? humanize(opts.dirName ?? projectId), LIMITS.name);
  const status2 = { pending: 0, working: 0, blocked: 0, done: 0 };
  for (const s of statuses) status2[s]++;
  return {
    projectId,
    graph: { name, lang: dataLang, stages: stages2, nodes },
    stats: {
      nodes: nodes.length,
      edges: nodes.reduce((n, node) => n + (node.deps?.length ?? 0), 0),
      stageSource: source,
      stages: stages2.map((s) => ({ id: s.id, name: s.name, nodes: stageOf.filter((x) => x === s.id).length })),
      status: status2,
      asksHuman: askers,
      ...given ? { titled: given.size } : {}
    },
    warnings
  };
}
function readTitles(raw) {
  let text = raw;
  if (!raw.trim().startsWith("{")) {
    try {
      text = readFileSync2(raw, "utf8");
    } catch {
      throw new Error(t(`\xAB${raw}\xBB is neither a JSON object nor a file I can read`, `\xAB${raw}\xBB no es un objeto JSON ni un archivo que pueda leer`));
    }
  }
  let parsed;
  try {
    parsed = JSON.parse(text);
  } catch (err) {
    const why = err instanceof Error ? err.message : String(err);
    throw new Error(t(`it is not valid JSON (${why})`, `no es JSON v\xE1lido (${why})`));
  }
  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
    throw new Error(t('expected an object { "node id": "title" }', 'se esperaba un objeto { "id de nodo": "t\xEDtulo" }'));
  }
  return parsed;
}
function givenTitles(titles, tasks, nodeIds, warnings) {
  const byKey = /* @__PURE__ */ new Map();
  nodeIds.forEach((id, i) => byKey.set(id, i));
  tasks.forEach((t2, i) => {
    const k = slugify(t2.id);
    if (k && !byKey.has(k)) byKey.set(k, i);
  });
  const out = /* @__PURE__ */ new Map();
  const keyOf = /* @__PURE__ */ new Map();
  for (const [key, value] of Object.entries(titles)) {
    const i = byKey.get(key) ?? byKey.get(slugify(key));
    if (i === void 0) {
      warnings.push(t(`--titles: there is no task \xAB${key}\xBB; ignored`, `--titles: no hay ninguna tarea \xAB${key}\xBB; se ignor\xF3`));
      continue;
    }
    const title = typeof value === "string" ? value.replace(/\s+/g, " ").trim() : "";
    const fallback = legibleTitle(tasks[i].title, tasks[i].summary);
    const keep = t(`kept \xAB${fallback}\xBB`, `qued\xF3 \xAB${fallback}\xBB`);
    if (!title) {
      warnings.push(t(`--titles: the title for \xAB${key}\xBB is not text with content; ${keep}`, `--titles: el t\xEDtulo de \xAB${key}\xBB no es un texto con contenido; ${keep}`));
      continue;
    }
    const len = [...title].length;
    if (len > LIMITS.title) {
      warnings.push(
        t(
          `--titles: the title for \xAB${key}\xBB has ${len} characters (at most ${LIMITS.title}); ${keep}`,
          `--titles: el t\xEDtulo de \xAB${key}\xBB tiene ${len} caracteres (m\xE1ximo ${LIMITS.title}); ${keep}`
        )
      );
      continue;
    }
    if (out.has(i)) {
      const prev = keyOf.get(i);
      warnings.push(t(`--titles: \xAB${prev}\xBB and \xAB${key}\xBB are the same task; kept the one from \xAB${key}\xBB`, `--titles: \xAB${prev}\xBB y \xAB${key}\xBB son la misma tarea; qued\xF3 el de \xAB${key}\xBB`));
    }
    out.set(i, title);
    keyOf.set(i, key);
  }
  return out;
}
function effectiveStatus(t2) {
  return t2.status === "blocked" ? "pending" : t2.status;
}
function asksHuman(t2, myDeps, tasks) {
  if (t2.status !== "blocked") return false;
  return t2.needsHuman || !myDeps.some((d) => tasks[d].status !== "done");
}
function breakCycles(deps) {
  const color = deps.map(() => 0);
  const back = [];
  const visit = (to) => {
    color[to] = 1;
    for (const from of deps[to]) {
      if (color[from] === 1) back.push([from, to]);
      else if (color[from] === 0) visit(from);
    }
    color[to] = 2;
  };
  deps.forEach((_, i) => color[i] === 0 && visit(i));
  return back;
}
function longestPathDepth(deps) {
  const memo = /* @__PURE__ */ new Map();
  const depthOf = (i) => {
    const known = memo.get(i);
    if (known !== void 0) return known;
    const d = deps[i].length ? 1 + Math.max(...deps[i].map(depthOf)) : 0;
    memo.set(i, d);
    return d;
  };
  return deps.map((_, i) => depthOf(i));
}
function inferStages(tasks, depth, lang3) {
  const phases = new Set(tasks.map((t2) => t2.phase?.toLowerCase()));
  if (tasks.length > 0 && tasks.every((t2) => t2.phase) && phases.size <= MAX_STAGES) {
    const known = DEFAULT_STAGES_BY_LANG[lang3];
    const order = [];
    const stageOf = tasks.map((t2, i) => {
      const word = t2.phase.toLowerCase();
      const k = PHASE_WORDS.findIndex((words) => words.includes(word));
      const id = k >= 0 ? known[k].id : slugify(word) || "etapa";
      const name = k >= 0 ? known[k].name : humanize(t2.phase);
      const existing = order.find((s) => s.id === id);
      if (existing) existing.minDepth = Math.min(existing.minDepth, depth[i]);
      else order.push({ id, name, rank: k >= 0 ? k : PHASE_WORDS.length, minDepth: depth[i] });
      return id;
    });
    order.sort((a, b) => a.rank - b.rank || a.minDepth - b.minDepth);
    return { stages: order.map(({ id, name }) => ({ id, name })), stageOf, source: "phase" };
  }
  const max = Math.min(depth.length ? Math.max(...depth) : 0, MAX_STAGES - 1);
  const stages2 = Array.from({ length: max + 1 }, (_, d) => {
    const name = depthStageName(d, max, lang3);
    return { id: slugify(name), name };
  });
  return { stages: stages2, stageOf: depth.map((d) => stages2[Math.min(d, max)].id), source: "depth" };
}

// src/sync/github.ts
import { execFile } from "node:child_process";
var defaultExec = (file, args) => new Promise((resolve3, reject) => {
  execFile(file, args, { maxBuffer: 256 * 1024 * 1024, encoding: "utf8" }, (err, stdout, stderr) => {
    if (!err) return resolve3(stdout);
    if (err.code === "ENOENT") {
      return reject(new Error(t("gh (GitHub CLI) was not found: install it and run \xABgh auth login\xBB", "no encontr\xE9 gh (GitHub CLI): inst\xE1lalo y corre \xABgh auth login\xBB")));
    }
    const cmd = `gh ${args.slice(0, 3).join(" ")}`;
    const why = oneLine(String(stderr || err.message), 500);
    reject(new Error(t(`${cmd} failed: ${why}`, `${cmd} fall\xF3: ${why}`)));
  });
});
var ISSUE_JQ = ".[] | {number, title, body, state, state_reason, html_url, labels: [.labels[].name], pull_request: (.pull_request != null)}";
var PULL_JQ = ".[] | {number, title, body}";
function ghCliSource(exec = defaultExec) {
  const lines = async (path, jq) => {
    const out = await exec("gh", ["api", "--paginate", path, "--jq", jq]);
    return out.split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
  };
  return {
    async issues(repo, opts) {
      const qs = new URLSearchParams({ state: "all", per_page: "100" });
      if (opts.label) qs.set("labels", opts.label);
      const rows = await lines(`repos/${repo}/issues?${qs.toString().replace(/\+/g, "%20")}`, ISSUE_JQ);
      return rows.map((r) => ({
        number: Number(r.number),
        title: String(r.title ?? ""),
        body: typeof r.body === "string" ? r.body : "",
        state: r.state === "closed" ? "closed" : "open",
        stateReason: typeof r.state_reason === "string" ? r.state_reason : null,
        url: String(r.html_url ?? ""),
        labels: Array.isArray(r.labels) ? r.labels.map(String) : [],
        isPull: r.pull_request === true
      }));
    },
    async openPulls(repo) {
      const rows = await lines(`repos/${repo}/pulls?state=open&per_page=100`, PULL_JQ);
      return rows.map((r) => ({
        number: Number(r.number),
        title: String(r.title ?? ""),
        body: typeof r.body === "string" ? r.body : ""
      }));
    }
  };
}
var PREFIX = /^[\p{L}\p{N}_./-]+(?:\([^)]*\))?!?:\s+/u;
function cleanTitle2(raw) {
  const line = oneLine(raw, 1e4);
  const bare = line.replace(PREFIX, "") || line;
  const capped = bare.replace(new RegExp("\\p{L}", "u"), (c) => c.toLocaleUpperCase("es"));
  return oneLine(capped, LIMITS.title);
}
var REF_PHRASE = /\s*\(?\s*(?:(?:desde|tras|después de|según|por|ver|véase|see|since|after|from|per)\s+)?#\d+\s*\)?/giu;
function issueNodeTitle(raw, n) {
  const bare = cleanTitle2(raw).replace(REF_PHRASE, " ");
  const t2 = legibleTitle(oneLine(bare, 1e4) || raw);
  return t2 && t2 !== "Tarea" ? t2 : `Issue ${n}`;
}
var REF_LIST = String.raw`#\d+(?:\s*(?:,|\by\b|\be\b|\band\b|&)\s*#\d+)*`;
function refsAfter(text, phrases) {
  const out = [];
  const re = new RegExp(String.raw`(?:^|[^\p{L}])(?:${phrases})\s*:?\s+(${REF_LIST})`, "giu");
  for (const m of text.matchAll(re)) {
    for (const n of m[1].matchAll(/#(\d+)/g)) out.push(Number(n[1]));
  }
  return [...new Set(out)];
}
function closingRefs(text) {
  const out = [];
  const re = /(?:^|[^\p{L}])(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?|cierra|resuelve)\s*:?\s+#(\d+)/giu;
  for (const m of text.matchAll(re)) out.push(Number(m[1]));
  return [...new Set(out)];
}
function dependencyRefs(text) {
  return {
    partOf: refsAfter(text, "parte de|part of"),
    dependsOn: refsAfter(text, "depende de|depends on|blocked by|bloquead[oa] por"),
    bornFrom: refsAfter(text, "sale de la revisi[o\xF3]n de|nace de|born from")
  };
}
var OPTION_BOLD = /^\s*[-*]\s+\*\*\s*([A-Za-z0-9]{1,2})\s*(?:\(([^)]*)\))?\s*[:.)]?\s*\*\*\s*[:.)]?\s*(.*)$/;
var OPTION_PAREN = /^\s*[-*]\s+([A-Za-z0-9]{1,2})\)\s+(.+)$/;
function parseOptions(body) {
  const out = [];
  for (const line of body.split(/\r?\n/)) {
    let letter;
    let note;
    let text;
    const bold = OPTION_BOLD.exec(line);
    const paren = bold ? null : OPTION_PAREN.exec(line);
    if (bold) [, letter, note, text] = bold;
    else if (paren) [, letter, text] = paren;
    else continue;
    const plain = text.replace(/\*\*|__|`/g, "").trim();
    const head = note?.trim() ? `${letter} (${note.trim()})` : letter;
    const option = oneLine(plain ? `${head}: ${plain}` : head, LIMITS.option);
    if (!out.includes(option)) out.push(option);
    if (out.length === LIMITS.options) break;
  }
  return out;
}

// src/sync/sync.ts
var FOUNDER_LABEL = "founder-input";
var EPIC_LABEL = "epic";
var RANK = { pending: 0, working: 1, blocked: 1, done: 2 };
var STATUS_EN = { pending: "Pending", working: "In progress", blocked: "Needs you", done: "Done" };
var STATUS_ES = { pending: "Pendiente", working: "En progreso", blocked: "Te espera", done: "Lista" };
var statusHuman = (s) => t(STATUS_EN[s], STATUS_ES[s]);
var nodeIdOf = (n) => `gh-${n}`;
async function syncGithub(api, source, projectId, opts) {
  const dry = !!opts.dryRun;
  const snap = await api.snapshot(projectId);
  const lang3 = projectLang(snap.project);
  const stage = pickStage(snap.project.stages, opts.stage, lang3);
  const listed = await source.issues(opts.repo, opts.label ? { label: opts.label } : {});
  const issues = listed.filter((i) => !i.isPull).sort((a, b) => a.number - b.number);
  const withPr = /* @__PURE__ */ new Set();
  for (const pr of await source.openPulls(opts.repo)) for (const n of closingRefs(`${pr.title}
${pr.body}`)) withPr.add(n);
  const nodes = new Map(snap.nodes.map((n) => [n.id, n]));
  const edges = snap.edges.map((e) => ({ from: e.from, to: e.to }));
  const origins2 = (snap.origins ?? []).map((o) => ({ from: o.from, to: o.to }));
  const report = {
    repo: opts.repo,
    project: projectId,
    dryRun: dry,
    issues: 0,
    created: [],
    updated: [],
    unchanged: [],
    actions: [],
    warnings: []
  };
  const created = /* @__PURE__ */ new Set();
  const foreign = /* @__PURE__ */ new Set();
  const updated = /* @__PURE__ */ new Set();
  const considered = [];
  const soft = async (what, fn) => {
    try {
      return await fn();
    } catch (err) {
      if (err instanceof ApiRequestError && [400, 404, 409].includes(err.status)) {
        report.warnings.push(`${what}: ${err.message}`);
        return void 0;
      }
      throw err;
    }
  };
  for (const issue of issues) {
    const id = nodeIdOf(issue.number);
    const existing = nodes.get(id);
    const completed = issue.state === "closed" && (issue.stateReason === "completed" || issue.stateReason === null);
    if (!existing) {
      if (issue.state === "closed" && (!opts.all || !completed)) continue;
      if (issue.labels.includes(EPIC_LABEL)) continue;
      const input = {
        id,
        stage,
        title: issueNodeTitle(issue.title, issue.number),
        status: completed ? "done" : withPr.has(issue.number) ? "working" : "pending",
        link: issue.url
      };
      considered.push(issue);
      const ok = dry || await soft(t(`could not create ${id}`, `no pude crear ${id}`), () => api.addNode(projectId, input)) !== void 0;
      if (!ok) continue;
      nodes.set(id, { id, status: input.status, link: input.link });
      created.add(id);
      report.actions.push(t(`new ${id} \xAB${input.title}\xBB (${statusHuman(input.status)})`, `nuevo ${id} \xAB${input.title}\xBB (${statusHuman(input.status)})`));
      continue;
    }
    if (existing.link && linkClash(existing.link, issue, opts.repo)) {
      foreign.add(id);
      report.warnings.push(
        t(
          `${id} points to ${existing.link}, not to ${issue.url}: skipped it (another repo with the same number?)`,
          `${id} apunta a ${existing.link}, no a ${issue.url}: lo salt\xE9 (\xBFotro repo con el mismo n\xFAmero?)`
        )
      );
      continue;
    }
    considered.push(issue);
    const patch = {};
    if (!existing.link && issue.url) patch.link = issue.url;
    const want = completed ? "done" : issue.state === "open" && withPr.has(issue.number) ? "working" : null;
    if (want && RANK[want] > RANK[existing.status]) {
      if (existing.status === "blocked" || hasOpenBlocker(snap.blockers, id)) {
        report.warnings.push(openQuestion(id, want));
      } else {
        patch.status = want;
      }
    }
    if (!Object.keys(patch).length) continue;
    let applied = patch;
    if (!dry) {
      try {
        await api.updateNode(projectId, id, patch);
      } catch (err) {
        if (!(err instanceof ApiRequestError) || ![400, 404, 409].includes(err.status)) throw err;
        if (err.status !== 409 || !patch.status) {
          report.warnings.push(t(`could not update ${id}: ${err.message}`, `no pude actualizar ${id}: ${err.message}`));
          continue;
        }
        report.warnings.push(openQuestion(id, patch.status));
        const { status: _skip, ...rest } = patch;
        applied = rest;
        if (!Object.keys(rest).length) continue;
        if (await soft(t(`could not update ${id}`, `no pude actualizar ${id}`), () => api.updateNode(projectId, id, rest)) === void 0) continue;
      }
    }
    nodes.set(id, { ...existing, ...applied.link ? { link: applied.link } : {}, ...applied.status ? { status: applied.status } : {} });
    updated.add(id);
    const what = [applied.status ? statusHuman(applied.status) : null, applied.link ? t("link to the issue", "enlace al issue") : null].filter(Boolean);
    report.actions.push(`${id}: ${what.join(", ")}`);
  }
  for (const issue of considered) {
    const self = nodeIdOf(issue.number);
    if (!nodes.has(self)) continue;
    const refs = dependencyRefs(issue.body);
    const wanted = [
      ...refs.partOf.map((n) => [self, nodeIdOf(n)]),
      // la épica necesita sus partes
      ...refs.dependsOn.map((n) => [nodeIdOf(n), self])
    ];
    for (const [from, to] of wanted) {
      if (from === to || !nodes.has(from) || !nodes.has(to) || foreign.has(from) || foreign.has(to)) continue;
      if (edges.some((e) => e.from === from && e.to === to)) continue;
      if (dry) {
        if (wouldCreateCycle(edges, from, to)) {
          report.warnings.push(cycleWarning(from, to));
          continue;
        }
      } else {
        try {
          await api.addEdge(projectId, from, to);
        } catch (err) {
          if (!(err instanceof ApiRequestError)) throw err;
          if (err.status === 400 && err.code === "cycle") report.warnings.push(cycleWarning(from, to));
          else if (err.status === 409) report.warnings.push(t(`${from} \u2192 ${to} already existed`, `${from} \u2192 ${to} ya exist\xEDa`));
          else if ([400, 404].includes(err.status)) report.warnings.push(t(`did not add ${from} \u2192 ${to}: ${err.message}`, `no agregu\xE9 ${from} \u2192 ${to}: ${err.message}`));
          else throw err;
          continue;
        }
      }
      edges.push({ from, to });
      updated.add(self);
      report.actions.push(`${from} \u2192 ${to}`);
    }
    for (const n of refs.bornFrom) {
      const from = nodeIdOf(n);
      if (from === self || !nodes.has(from) || foreign.has(from) || foreign.has(self)) continue;
      if (origins2.some((o) => o.from === from && o.to === self)) continue;
      if (dry) {
        if (wouldCreateCycle(origins2, from, self)) {
          report.warnings.push(bornCycleWarning(from, self));
          continue;
        }
      } else {
        try {
          await api.addEdge(projectId, from, self, { kind: "origin" });
        } catch (err) {
          if (!(err instanceof ApiRequestError)) throw err;
          if (err.status === 400 && err.code === "cycle") report.warnings.push(bornCycleWarning(from, self));
          else if (err.status === 409) report.warnings.push(t(`${self} was already born from ${from}`, `${self} ya nac\xEDa de ${from}`));
          else if ([400, 404].includes(err.status)) report.warnings.push(t(`did not say ${self} was born from ${from}: ${err.message}`, `no dije que ${self} naci\xF3 de ${from}: ${err.message}`));
          else throw err;
          continue;
        }
      }
      origins2.push({ from, to: self });
      updated.add(self);
      report.actions.push(t(`${self} born from ${from}`, `${self} naci\xF3 de ${from}`));
    }
  }
  for (const issue of considered) {
    if (issue.state !== "open" || !issue.labels.includes(FOUNDER_LABEL)) continue;
    const id = nodeIdOf(issue.number);
    const node = nodes.get(id);
    if (!node || node.status === "done") continue;
    if (snap.blockers.some((b) => b.nodeId === id && b.kind === "decision")) continue;
    const question = oneLine(cleanTitle2(issue.title), LIMITS.question);
    const options = parseOptions(issue.body);
    const input = { kind: "decision", question, options: options.length ? options : [...YES_NO[lang3]] };
    if (!dry && await soft(t(`could not open the question for ${id}`, `no pude abrir la pregunta de ${id}`), () => api.openBlocker(projectId, id, input)) === void 0) continue;
    nodes.set(id, { ...node, status: "blocked" });
    updated.add(id);
    report.actions.push(t(`${id}: asks the owner \xAB${question}\xBB`, `${id}: pregunta al due\xF1o \xAB${question}\xBB`));
  }
  report.issues = considered.length;
  for (const issue of considered) {
    const id = nodeIdOf(issue.number);
    if (created.has(id)) report.created.push(id);
    else if (updated.has(id)) report.updated.push(id);
    else report.unchanged.push(id);
  }
  return report;
}
function linkClash(link, issue, repo) {
  const norm = (u) => u.trim().replace(/\/+$/, "").toLowerCase();
  const l = norm(link);
  if (l === norm(issue.url)) return false;
  const base = `https://github.com/${repo.toLowerCase()}/`;
  if (!l.startsWith(base)) return true;
  const m = /^issues\/(\d+)(?:[/?#]|$)/.exec(l.slice(base.length));
  return !!m && Number(m[1]) !== issue.number;
}
function openQuestion(id, status2) {
  return t(
    `${id} has an open question for the owner; did not move it to ${statusHuman(status2)}`,
    `${id} tiene una pregunta abierta para el due\xF1o; no lo pas\xE9 a ${statusHuman(status2)}`
  );
}
function cycleWarning(from, to) {
  return t(`did not add ${from} \u2192 ${to}: it would close a loop`, `no agregu\xE9 ${from} \u2192 ${to}: cerrar\xEDa un ciclo`);
}
function bornCycleWarning(from, to) {
  return t(`did not say ${to} was born from ${from}: it would close a loop`, `no dije que ${to} naci\xF3 de ${from}: cerrar\xEDa un ciclo`);
}
function hasOpenBlocker(blockers, nodeId2) {
  return blockers.some((b) => b.nodeId === nodeId2 && b.status === "open");
}
function pickStage(stages2, wanted, lang3) {
  if (!stages2.length) throw new UsageError(t("the project has no stages", "el proyecto no tiene etapas"));
  if (wanted !== void 0) {
    const hit = findStage(stages2, wanted);
    if (!hit) {
      const ids = stages2.map((s) => s.id).join(", ");
      throw new UsageError(t(`there is no stage \xAB${wanted}\xBB; the project has: ${ids}`, `no existe la etapa \xAB${wanted}\xBB; las del proyecto: ${ids}`));
    }
    return hit.id;
  }
  return defaultSyncStage(stages2, lang3).id;
}
function formatSync(r) {
  const lines = [
    t(
      `Synced ${r.issues} issues: ${r.created.length} new \xB7 ${r.updated.length} updated \xB7 ${r.unchanged.length} unchanged`,
      `Sincronic\xE9 ${r.issues} issues: ${r.created.length} nuevas \xB7 ${r.updated.length} actualizadas \xB7 ${r.unchanged.length} sin cambios`
    )
  ];
  if (r.dryRun) lines.push(t(`This was a dry run: nothing was sent to \xAB${r.project}\xBB.`, `Fue una simulaci\xF3n: no se envi\xF3 nada a \xAB${r.project}\xBB.`));
  if (r.warnings.length) lines.push(t(`Warnings (${r.warnings.length}):`, `Avisos (${r.warnings.length}):`), ...r.warnings.map((w) => `  - ${w}`));
  return `${lines.join("\n")}
`;
}

// src/watch.ts
var EVENTS_PAGE = 500;
var WATCH_BACKOFF_MS = [1e3, 2e3, 5e3, 1e4];
var WATCH_GIVE_UP = 12;
var DOWN = /* @__PURE__ */ Symbol("down");
async function watch(o) {
  let failures = 0;
  let since = o.since;
  const emit = (line) => o.out(o.json ? `${JSON.stringify(line)}
` : `${formatLine(line)}
`);
  async function call(f) {
    for (; ; ) {
      try {
        const r = await f();
        if (failures) o.err(t("dagyard: the server answers again\n", "dagyard: el servidor volvi\xF3 a responder\n"));
        failures = 0;
        return r;
      } catch (err) {
        if (!(err instanceof ApiRequestError) || !transient2(err)) throw err;
        failures++;
        if (failures === 1) o.err(t(`dagyard: the server is not answering (${err.message}); retrying
`, `dagyard: el servidor no responde (${err.message}); reintento
`));
        if (failures >= WATCH_GIVE_UP) {
          const resume = since === null ? "" : ` --since ${since}`;
          o.err(
            t(
              `dagyard: the server did not answer ${failures} times in a row; I stop. Resume with \xABdagyard watch${resume}\xBB
`,
              `dagyard: el servidor no respondi\xF3 ${failures} veces seguidas; me detengo. Reanuda con \xABdagyard watch${resume}\xBB
`
            )
          );
          return DOWN;
        }
        await o.sleep(WATCH_BACKOFF_MS[Math.min(failures - 1, WATCH_BACKOFF_MS.length - 1)]);
      }
    }
  }
  async function fromSnapshot(resyncFrom) {
    const snap = await call(() => o.api.snapshot(o.project));
    if (snap === DOWN) return false;
    if (resyncFrom !== void 0) emit({ type: "resync", seq: snap.seq, since: resyncFrom });
    for (const b of openBlockers(snap)) emit(blockerLine("blocker.opened", snap.seq, b, b.createdAt, true));
    since = snap.seq;
    o.saveCursor?.(since);
    return true;
  }
  if (since === null && !await fromSnapshot()) return "unreachable";
  o.err(t(`dagyard: listening to \xAB${o.project}\xBB after event #${since}
`, `dagyard: escuchando \xAB${o.project}\xBB despu\xE9s del evento #${since}
`));
  for (; ; ) {
    const from = since;
    const page = await call(() => o.api.events(o.project, from));
    if (page === DOWN) return "unreachable";
    if (page.resync) {
      if (!await fromSnapshot(from)) return "unreachable";
      continue;
    }
    for (const ev of page.events) {
      if (ev.seq <= since) continue;
      const line = eventLine(ev);
      if (line) emit(line);
      since = ev.seq;
    }
    if (since !== from) o.saveCursor?.(since);
    if (page.events.length >= EVENTS_PAGE) continue;
    if (o.once) return "ok";
    await o.sleep(o.intervalMs);
  }
}
var transient2 = (err) => err.status === 0 || err.status >= 500 || err.status === 429;
function openBlockers(snap) {
  return snap.blockers.filter((b) => b.status === "open").sort((a, b) => a.createdAt.localeCompare(b.createdAt));
}
function eventLine(ev) {
  if (ev.type === "blocker.opened" || ev.type === "blocker.resolved") return blockerLine(ev.type, ev.seq, ev.payload.blocker, ev.at);
  return null;
}
function blockerLine(type, seq, b, at, snapshot = false) {
  const line = { type, seq, node: b.nodeId, blocker: b.id, kind: b.kind, question: b.question, options: b.options, at };
  if (type === "blocker.resolved") {
    line.choice = b.resolution?.choice ?? null;
    line.note = b.resolution?.note ?? null;
    line.by = b.resolvedBy;
  }
  if (snapshot) line.snapshot = true;
  return line;
}
function formatLine(l) {
  if (l.type === "resync") {
    return t(
      `#${l.seq} resync: the server no longer has the events after #${l.since}; going on from the current state`,
      `#${l.seq} resync: el servidor ya no tiene los eventos despu\xE9s de #${l.since}; sigo desde el estado actual`
    );
  }
  const q = `\xAB${oneLine(l.question, 500)}\xBB`;
  if (l.type === "blocker.opened") {
    const opts = l.options.length ? ` [${l.options.join(" | ")}]` : "";
    const verb = l.snapshot ? t("still waiting", "sigue esperando") : t("asks", "pregunta");
    return `#${l.seq} ${l.node} ${verb} (${l.kind}): ${q}${opts} \xB7 ${l.blocker}`;
  }
  const answer = l.kind === "access" ? t(`access saved (read it with \xABdagyard wait ${l.node} --blocker ${l.blocker}\xBB)`, `acceso guardado (l\xE9elo con \xABdagyard wait ${l.node} --blocker ${l.blocker}\xBB)`) : l.choice ?? t("(no option)", "(sin opci\xF3n)");
  const note = l.note ? ` \u2014 ${t("note", "nota")}: ${oneLine(l.note, 2e3)}` : "";
  return `#${l.seq} ${l.node} ${t("answered", "respondieron")} ${q}: ${answer}${note} \xB7 ${l.blocker}`;
}

// src/cli.ts
var VERSION = "0.1.0";
var EXIT = { ok: 0, api: 1, timeout: 2, nothing: 3, unreachable: 4, usage: 64 };
var tx = (text) => t(text[0], text[1]);
var GLOBAL_FLAGS = ["project", "url"];
